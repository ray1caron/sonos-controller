{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Defence-in-depth deny-list for the Sonos Controller backend. Even when Claude Code is launched with --dangerously-skip-permissions for workflow speed, these reads are blocked. See CLAUDE.md > Security and secrets for the rationale.",

  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",

      "Read(**/secrets/*)",
      "Read(**/secret/*)",
      "Read(**/*credential*)",
      "Read(**/*credentials*)",
      "Read(**/*password*)",
      "Read(**/*passwd*)",

      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.*)",
      "Read(**/known_hosts)",
      "Read(**/authorized_keys)",

      "Read(/data/token)",
      "Read(**/data/token)",
      "Read(**/auth_token)",
      "Read(**/.token)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gitconfig)",
      "Read(~/.netrc)",

      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | bash*)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(*:|:&*)",

      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard origin/main)",
      "Bash(git reset --hard origin/master)"
    ]
  },

  "autoMemoryEnabled": true
}
